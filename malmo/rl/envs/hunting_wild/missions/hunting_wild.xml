<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Mission xmlns="http://ProjectMalmo.microsoft.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <About>
    <Summary>Hunting (wild) — pursue and kill a pig in natural Minecraft terrain</Summary>
  </About>

  <ServerSection>
    <ServerInitialConditions>
      <Time><StartTime>6000</StartTime><AllowPassageOfTime>false</AllowPassageOfTime></Time>
      <Weather>clear</Weather>
      <!-- Only the DrawEntity pig is spawned; no random mobs -->
      <AllowSpawning>false</AllowSpawning>
    </ServerInitialConditions>
    <ServerHandlers>
      <!-- Fixed seed reproduces the same natural terrain every episode.
           Calibration: after first run check agent spawn Y via ObservationFromFullStats
           and update HuntingWildCFG.SPAWN[1] + FALL_Y_THRESHOLD accordingly.
           Seed 4837 gives a moderately flat plains biome near (0,64). -->
      <DefaultWorldGenerator seed="4837" forceReset="true"/>

      <DrawingDecorator>
        <!-- Bedrock cage: bounds the play area so neither agent nor pig can escape.
             Inner walls at x=±21, z=±21 give a 42×42 block play area.
             Floor at y=61 (well below expected terrain surface ~63-65) so natural
             terrain floors the agent; ceiling at y=80 gives ample vertical room.
             Bedrock is indestructible and shows up in the voxel grid as type 3. -->
        <DrawCuboid x1="-21" y1="61" z1="-21" x2="21"  y2="80" z2="-21" type="bedrock"/>
        <DrawCuboid x1="-21" y1="61" z1="21"  x2="21"  y2="80" z2="21"  type="bedrock"/>
        <DrawCuboid x1="-21" y1="61" z1="-21" x2="-21" y2="80" z2="21"  type="bedrock"/>
        <DrawCuboid x1="21"  y1="61" z1="-21" x2="21"  y2="80" z2="21"  type="bedrock"/>
        <DrawCuboid x1="-21" y1="61" z1="-21" x2="21"  y2="61" z2="21"  type="bedrock"/>
        <!-- The target animal is injected here per-episode by reset() (DrawEntity) -->
      </DrawingDecorator>

      <ServerQuitFromTimeUp timeLimitMs="60000"/>
      <ServerQuitWhenAnyAgentFinishes/>
    </ServerHandlers>
  </ServerSection>

  <AgentSection mode="Survival">
    <Name>Hunter</Name>
    <AgentStart>
      <!-- y=65 is one block above expected ground level for seed 4837 plains.
           Calibrate if the agent spawns in the air or underground. -->
      <Placement x="0.5" y="65.0" z="0.5" yaw="0" pitch="0"/>
      <Inventory>
        <InventoryItem type="diamond_sword" slot="0"/>
      </Inventory>
    </AgentStart>
    <AgentHandlers>
      <ContinuousMovementCommands turnSpeedDegs="180"/>
      <ObservationFromFullStats/>
      <ObservationFromRay/>
      <ObservationFromNearbyEntities>
        <Range name="entities" xrange="25" yrange="6" zrange="25"/>
      </ObservationFromNearbyEntities>
      <ObservationFromGrid>
        <Grid name="floor3x3">
          <min x="-2" y="-1" z="-2"/>
          <max x="2"  y="1"  z="2"/>
        </Grid>
      </ObservationFromGrid>
      <RewardForDamagingEntity>
        <Mob type="Pig" reward="1"/>
      </RewardForDamagingEntity>
    </AgentHandlers>
  </AgentSection>
</Mission>
