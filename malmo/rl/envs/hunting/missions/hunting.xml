<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Mission xmlns="http://ProjectMalmo.microsoft.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <About>
    <Summary>Hunting — pursue and kill a passive animal for food</Summary>
  </About>

  <ServerSection>
    <ServerInitialConditions>
      <Time><StartTime>6000</StartTime><AllowPassageOfTime>false</AllowPassageOfTime></Time>
      <Weather>clear</Weather>
      <!-- No random mobs: the target animal is drawn explicitly per episode -->
      <AllowSpawning>false</AllowSpawning>
    </ServerInitialConditions>
    <ServerHandlers>
      <FlatWorldGenerator generatorString="3;7,2*3,2;1;" forceReset="true"/>

      <DrawingDecorator>
        <!-- Clear the play volume -->
        <DrawCuboid x1="-10" y1="46" z1="-10" x2="10" y2="50" z2="10" type="air"/>
        <!-- Solid floor at y=45 (agent + animal stand on top, feet at y=46).
             Without this the superflat surface is at ~y=4 and everything falls. -->
        <DrawCuboid x1="-9" y1="45" z1="-9" x2="9"  y2="45" z2="9"  type="grass"/>
        <!-- Walled arena (4 stone walls) so neither agent nor animal can leave:
             makes the task a PURSUIT, not a blind search -->
        <DrawCuboid x1="-9" y1="46" z1="-9" x2="9"  y2="49" z2="-9" type="stone"/>
        <DrawCuboid x1="-9" y1="46" z1="9"  x2="9"  y2="49" z2="9"  type="stone"/>
        <DrawCuboid x1="-9" y1="46" z1="-9" x2="-9" y2="49" z2="9"  type="stone"/>
        <DrawCuboid x1="9"  y1="46" z1="-9" x2="9"  y2="49" z2="9"  type="stone"/>
        <!-- The target animal is injected here per-episode by reset() (DrawEntity) -->
      </DrawingDecorator>

      <ServerQuitFromTimeUp timeLimitMs="60000"/>
      <ServerQuitWhenAnyAgentFinishes/>
    </ServerHandlers>
  </ServerSection>

  <AgentSection mode="Survival">
    <Name>Hunter</Name>
    <AgentStart>
      <Placement x="0.5" y="46.0" z="0.5" yaw="0" pitch="0"/>
      <Inventory>
        <InventoryItem type="diamond_sword" slot="0"/>
      </Inventory>
    </AgentStart>
    <AgentHandlers>
      <ContinuousMovementCommands turnSpeedDegs="180"/>
      <ObservationFromFullStats/>
      <ObservationFromRay/>
      <ObservationFromNearbyEntities>
        <Range name="entities" xrange="20" yrange="4" zrange="20"/>
      </ObservationFromNearbyEntities>
      <ObservationFromGrid>
        <Grid name="floor3x3">
          <min x="-2" y="-1" z="-2"/>
          <max x="2"  y="1"  z="2"/>
        </Grid>
      </ObservationFromGrid>
      <!-- Built-in per-hit signal (kept for reference; the env also derives a hit
           reward from the target's life drop, which is what _get_reward uses). -->
      <RewardForDamagingEntity>
        <Mob type="Pig" reward="1"/>
      </RewardForDamagingEntity>
    </AgentHandlers>
  </AgentSection>
</Mission>
